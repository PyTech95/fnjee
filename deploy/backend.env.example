# Copy to backend/.env on the VPS and fill in. MONGO_URL is injected by docker-compose.
DB_NAME=fnjee
ENV=production
JWT_SECRET=generate-with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
CORS_ORIGINS=https://fnjee.com
APP_BASE_URL=https://fnjee.com
WEBHOOK_CRON_SECRET=generate-another-random-string

# AI: leave empty and paste your OpenAI / Gemini / Claude key in Admin -> AI Settings
EMERGENT_LLM_KEY=

# Email: pick ONE transport
EMAIL_FROM_NAME=FNJEE.com
EMAIL_FROM_ADDRESS=noreply@fnjee.com
EMAIL_REPLY_TO=support@fnjee.com
# Option A - Resend (https://resend.com/api-keys, verify your domain first)
RESEND_API_KEY=
# Option B - SMTP (Gmail app password, Zoho, Brevo, AWS SES SMTP...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
